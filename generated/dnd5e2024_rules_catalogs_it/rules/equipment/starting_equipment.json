    },
    "notes": [
      "Questo catalogo collega le classi ai cataloghi oggetto gia esistenti: weapons, armors, shields, tools e adventuring_gear.",
      "Le opzioni con catalog 'choice' sono scelte che la UI deve risolvere prima di creare l'inventario.",
      "L'opzione B delle classi e' il denaro alternativo indicato nella tabella dei tratti della classe."
    ]
  },
  "equipment_rules": {
    "currency": {
      "base": "mo",
      "coin_weight": "50 monete pesano circa 0.5 kg",
      "values_in_gp": {
        "mr": 0.01,
        "ma": 0.1,
        "me": 0.5,
        "mo": 1,
        "mp": 10
      }
    },
    "armor": {
      "categories": ["leggera", "media", "pesante", "scudi"],
      "untrained_armor_penalty": "Se indossa armatura leggera, media o pesante senza competenza, il personaggio ha svantaggio a tutte le prove con d20 relative a Forza o Destrezza e non puo lanciare incantesimi.",
      "shield_rule": "Il bonus CA dello scudo si ottiene solo con competenza negli scudi.",
      "one_armor_one_shield": true,
      "strength_requirement_penalty": "Se un'armatura indica un requisito di Forza e il personaggio non lo soddisfa, la velocita diminuisce di 3 metri.",
      "stealth_disadvantage": "Le armature con furtivita svantaggio impongono svantaggio alle prove di Destrezza (Furtivita).",
      "don_doff_times": {
        "leggera": { "don": "1 minuto", "doff": "1 minuto" },
        "media": { "don": "5 minuti", "doff": "1 minuto" },
        "pesante": { "don": "10 minuti", "doff": "5 minuti" },
        "scudo": { "don": "azione di Utilizzo", "doff": "azione di Utilizzo" }
      }
    },
    "weapons": {
      "categories": ["semplice", "guerra"],
      "attack_ability_rules": {
        "melee": "Di norma Forza; proprieta Accurata consente Forza o Destrezza.",
        "ranged": "Di norma Destrezza.",
        "thrown": "Usa la stessa caratteristica dell'attacco in mischia, salvo regole specifiche."
      },
      "proficiency_rule": "Se il personaggio ha competenza nell'arma, aggiunge il bonus di competenza al tiro per colpire.",
      "damage_rule": "Al danno con arma si aggiunge lo stesso modificatore di caratteristica usato per il tiro per colpire, salvo eccezioni.",
      "properties": {
        "accurata": "Puoi usare Forza o Destrezza per attacco e danno.",
        "due_mani": "Richiede due mani quando attacchi.",
        "lancio": "Puo essere lanciata entro la gittata indicata.",
        "leggera": "Permette un attacco extra con azione bonus con un'altra arma leggera dopo l'azione di Attacco.",
        "munizioni": "Richiede munizioni; ogni attacco consuma munizioni e dopo il combattimento si recupera meta delle munizioni usate, arrotondata per difetto.",
        "pesante": "Svantaggio se usi arma pesante da mischia con Forza inferiore a 13 o arma pesante a distanza con Destrezza inferiore a 13.",
        "portata": "Aumenta la portata di 1.5 metri per attacchi e attacchi di opportunita.",
        "ricarica": "Permette un solo colpo con quell'arma quando usi azione, bonus o reazione per sparare.",
        "versatile": "Puo essere usata a una o due mani; tra parentesi indica il danno a due mani."
      }
    },
    "tools": {
      "proficiency_rule": "Con competenza in uno strumento, aggiungi il bonus di competenza alle prove con quello strumento. Se anche l'abilita usata e' competente, la prova ha vantaggio.",
      "separate_variants": true
    }
  },
