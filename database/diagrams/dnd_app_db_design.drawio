  <diagram id="phb-coverage" name="Copertura Manuale PHB">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-phb" value="Copertura regole Manuale del Giocatore 2024 nel DB v2" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="phb-core" value="Cap. 1 - Come si gioca&#xa;D20, competenza, azioni&#xa;movimento, taglia, copertura&#xa;danni, condizioni, riposi&#xa;&#xa;Tabelle DB:&#xa;rule_actions&#xa;rule_sizes&#xa;rule_movement_modes&#xa;rule_senses&#xa;rule_area_shapes&#xa;rule_cover_types&#xa;rule_damage_types&#xa;rule_conditions&#xa;rule_rest_types&#xa;rule_hazards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="300" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phb-creation" value="Cap. 2 - Creazione PG&#xa;classe, origini, ability scores&#xa;lingue, equipaggiamento&#xa;livello 0 / bozza&#xa;avanzamento e multiclass&#xa;&#xa;Tabelle DB:&#xa;characters&#xa;character_ability_bases&#xa;character_classes&#xa;character_progression_events&#xa;character_choices&#xa;rule_multiclass_prerequisites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="300" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phb-classes" value="Cap. 3 - Classi&#xa;privilegi automatici&#xa;scelte di classe/sottoclasse&#xa;risorse, ASI/talenti&#xa;padronanza armi&#xa;&#xa;Tabelle DB:&#xa;rule_classes&#xa;rule_subclasses&#xa;rule_class_features&#xa;rule_class_levels&#xa;rule_effects&#xa;rule_modifier_templates&#xa;character_grants&#xa;character_modifiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="300" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phb-origins" value="Cap. 4 - Origini&#xa;background&#xa;specie&#xa;talenti&#xa;strumenti/lingue&#xa;&#xa;Tabelle DB:&#xa;rule_species&#xa;rule_backgrounds&#xa;rule_feats&#xa;rule_tools&#xa;rule_languages&#xa;character_proficiencies&#xa;character_modifiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="100" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phb-equipment" value="Cap. 6 - Equipaggiamento&#xa;armi/armature/scudi&#xa;proprieta armi&#xa;maestrie armi&#xa;strumenti e focus&#xa;sintonia oggetti magici&#xa;&#xa;Tabelle DB:&#xa;rule_equipment&#xa;rule_weapon_properties&#xa;rule_weapon_masteries&#xa;rule_equipment_weapon_properties&#xa;rule_equipment_weapon_masteries&#xa;rule_tools&#xa;character_inventory&#xa;character_attunements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="phb-spells" value="Cap. 7 - Incantesimi&#xa;liste per classe&#xa;slot, pact magic&#xa;preparati/conosciuti&#xa;componenti, rituali, concentrazione&#xa;aree e stat block evocati&#xa;&#xa;Tabelle DB:&#xa;rule_spells&#xa;rule_class_spell_lists&#xa;rule_spell_slot_progressions&#xa;character_spellcasting_profiles&#xa;character_spells&#xa;character_spell_slots&#xa;rule_area_shapes&#xa;rule_creatures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="phb-creatures" value="Appendice B - Creature&#xa;stat block&#xa;taglia, tipo, CA, PF&#xa;velocita, sensi&#xa;azioni, tratti&#xa;evocazioni degli incantesimi&#xa;&#xa;Tabelle DB:&#xa;rule_creatures&#xa;rule_sizes&#xa;rule_senses&#xa;combat_participants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="440" width="300" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phb-runtime" value="Runtime partita&#xa;combattimento&#xa;iniziativa/turni&#xa;PF e risorse correnti&#xa;condizioni attive&#xa;reazione/azioni in futuro&#xa;&#xa;Tabelle DB:&#xa;campaign_scenes&#xa;encounters&#xa;combat_sessions&#xa;combat_participants&#xa;character_current_state&#xa;character_resources&#xa;active_conditions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="440" width="280" height="260" as="geometry" />
