        <mxCell id="ui" value="React Frontend&#xa;Home&#xa;Gestione PG&#xa;Scheda PG&#xa;Progressione&#xa;Campagne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
