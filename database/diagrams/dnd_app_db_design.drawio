        <mxCell id="importers" value="Importatori cataloghi&#xa;JSON classi&#xa;JSON powers&#xa;JSON spells&#xa;JSON feats/equipment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="790" y="460" width="270" height="140" as="geometry" />
