        <mxCell id="db" value="MariaDB dnd_app_v2&#xa;catalogo regole&#xa;personaggi&#xa;progression events&#xa;choices/grants/modifiers&#xa;runtime state" style="cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
