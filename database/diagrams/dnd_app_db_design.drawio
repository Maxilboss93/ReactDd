        <mxCell id="snapshots" value="Projection / Cache&#xa;character_sheet_snapshots&#xa;JSON scheda pronta per UI&#xa;rigenerabile dai dati fonte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="430" y="460" width="260" height="130" as="geometry" />
